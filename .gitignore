# ---------------------------------------------------------------------------
# Generated repository tree. Published to Cloudflare R2, never committed.
# GitHub blocks files larger than 100 MiB, so package binaries must stay out.
# ---------------------------------------------------------------------------
repo/

# ---------------------------------------------------------------------------
# Staged build artifacts (incoming packages). Local drop zone only: the whole
# directory is ignored. publish.sh creates it if it does not exist.
# ---------------------------------------------------------------------------
packages/

# Local scratch space
.tmp/
*.log
