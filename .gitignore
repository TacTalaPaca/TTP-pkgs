# ---------------------------------------------------------------------------
# Generated repository tree. Published to Cloudflare R2, never committed.
# GitHub blocks files larger than 100 MiB, so package binaries must stay out.
# ---------------------------------------------------------------------------
repo/

# ---------------------------------------------------------------------------
# Staged build artifacts (incoming packages). This is a local drop zone only:
# nothing inside it is versioned. The originals live in each project's own
# packages/<version>/ directory.
# ---------------------------------------------------------------------------
packages/*
!packages/.gitkeep

# Local scratch space
.tmp/
*.log
